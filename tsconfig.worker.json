{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-worker",
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "strict": false
  },
  "include": ["src/lib/queue/workers/**/*.ts", "src/services/**/*.ts"]
}
